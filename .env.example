# nexus uses bare variable names (no NEXUS_ prefix), matching the four
# incumbent tenant repos.
UPSTREAM_TIMEOUT_S=60

# One API key per tenant. Names come from each policies/<tenant>.yaml.
NEXUS_KEY_HELPMATE=
NEXUS_KEY_SHOPSCOUT=
NEXUS_KEY_WEALTHWISE=
NEXUS_KEY_AURA=
NEXUS_KEY_WUWORK=

# Control-plane administrators, as name:key pairs. A `:ro` in the middle
# marks a read-only one: `kevin:nx-a,ops-li:ro:nx-b`. Named rather than one
# shared key, because an audit row that says "admin" names nobody.
# Unset means /admin is not mounted at all -- so is an empty DATABASE_URL,
# since a control plane whose changes die on restart is a lie.
NEXUS_ADMIN_KEYS=

# "fake" (default, offline) or "litellm" (reaches real providers)
UPSTREAM=fake
GLM_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=

# Postgres ledger. Empty means the in-memory ledger.
# NOTE: the pg tests read this from the *shell* environment, not from this
# file -- conftest disables .env during tests on purpose. Run them with
#   make test-live   (loads .env into the shell for you)
DATABASE_URL=
