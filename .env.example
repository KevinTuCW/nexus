# nexus uses bare variable names (no NEXUS_ prefix), matching the four
# incumbent tenant repos.
UPSTREAM_TIMEOUT_S=60

# One API key per tenant. Names come from each policies/<tenant>.yaml.
NEXUS_KEY_HELPMATE=
NEXUS_KEY_SHOPSCOUT=
NEXUS_KEY_WEALTHWISE=
NEXUS_KEY_AURA=
NEXUS_KEY_WUWORK=

# Control-plane accounts are NOT configured here. They live in Postgres and
# are created from the shell so a plaintext password never sits in a file
# that gets copied, shared or committed:
#   make admin-add USER=kevin          (prompts; rw by default)
#   make admin-add USER=li ROLE=ro
# /admin is mounted whenever DATABASE_URL is set; with no accounts the login
# form is there and nothing gets past it.
#
# Session cookies are Secure by default. Browsers treat http://localhost as a
# trustworthy origin, so leave this alone unless you are terminating TLS
# somewhere this process cannot see.
# ADMIN_COOKIE_SECURE=true

# "fake" (default, offline) or "litellm" (reaches real providers)
UPSTREAM=fake
GLM_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=

# Postgres ledger. Empty means the in-memory ledger.
# NOTE: the pg tests read this from the *shell* environment, not from this
# file -- conftest disables .env during tests on purpose. Run them with
#   make test-live   (loads .env into the shell for you)
DATABASE_URL=
